# Variables de entorno para el backend
# Copiar este archivo a .env y completar con tus valores

# Database Configuration (Supabase PostgreSQL)
# Obtener de: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/database
DB_CONNECTION=pgsql
DB_HOST=your_supabase_host_here
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# Supabase Configuration
# Obtener de: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=your_supabase_url_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# JWT Configuration
# Generar una clave secreta segura (mínimo 32 caracteres)
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
JWT_EXPIRATION=86400

# Application Configuration
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# CORS Configuration
# Agregar las URLs permitidas separadas por comas
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
