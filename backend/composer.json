{
    "name": "gestion-citas-medicas/backend",
    "description": "Backend API para Sistema de Gestión de Citas Médicas",
    "type": "project",
    "require": {
        "php": "^8.1",
        "illuminate/database": "^10.0",
        "illuminate/events": "^10.0",
        "vlucas/phpdotenv": "^5.5",
        "firebase/php-jwt": "^7.0",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "tuupola/cors-middleware": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
