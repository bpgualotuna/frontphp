# Variables de entorno para producción (Render)
# Estas se configurarán en el dashboard de Render

# IMPORTANTE: Después del primer deploy, actualizar esta URL con la URL real del backend
VITE_API_BASE_URL=https://your-backend-url.onrender.com/api

VITE_APP_NAME=Sistema de Gestión Médica

# Supabase (configurar en Render)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
